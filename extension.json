{
	"name": "WikibaseBoolean",
	"author": [
		"Luca Mauri"
	],
	"url": "https://github.com/lucamauri/WikibaseBoolean",
	"descriptionmsg": "wikibaseboolean-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "wikibase",
	"requires": {
		"MediaWiki": ">= 1.43.0",
		"extensions": {
			"WikibaseRepository": "*"
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\WikibaseBoolean\\": "src/"
	},
	"TestAutoloadNamespaces": {
		"MediaWiki\\Extension\\WikibaseBoolean\\Tests\\": "tests/phpunit/"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\WikibaseBoolean\\Hooks"
		}
	},
	"Hooks": {
		"WikibaseRepoDataTypes": "main"
	},
	"MessagesDirs": {
		"WikibaseBoolean": [
			"i18n"
		]
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "WikibaseBoolean/resources"
	},
	"ResourceModules": {
		"jquery.valueview.experts.Boolean": {
			"scripts": [
				"experts/Boolean.js"
			],
			"dependencies": [
				"jquery.valueview.Expert"
			],
			"targets": [
				"desktop",
				"mobile"
			]
		}
	},
	"manifest_version": 2
}
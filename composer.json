{
	"name": "lucamauri/wikibase-boolean",
	"type": "mediawiki-extension",
	"description": "Native 2-state Boolean datatype for standalone Wikibase installs.",
	"homepage": "https://github.com/lucamauri/WikibaseBoolean",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Luca Mauri"
		}
	],
	"require": {
		"php": ">=8.1",
		"composer/installers": "^2 || ^1.0.1",
		"data-values/data-values": "^3.1",
		"data-values/interfaces": "^1.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.5 || ^10.0",
		"mediawiki/mediawiki-codesniffer": "^45.0"
	},
	"autoload": {
		"psr-4": {
			"MediaWiki\\Extension\\WikibaseBoolean\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"MediaWiki\\Extension\\WikibaseBoolean\\Tests\\": "tests/phpunit/"
		}
	},
	"scripts": {
		"test": [
			"composer validate --no-interaction",
			"phpunit"
		],
		"cs": [
			"phpcs -p -s"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true
		}
	}
}
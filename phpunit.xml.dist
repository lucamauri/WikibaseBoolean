<?xml version="1.0" encoding="UTF-8"?>
<!--
	Standalone PHPUnit configuration, for classes that depend only on
	Composer-installable packages (data-values/*) and not on a running
	MediaWiki/Wikibase service container.

	This currently covers BooleanParser, BooleanFormatter and
	BooleanValidator's tests. It does NOT cover Hooks or BooleanRdfMapper:
	Hooks implements a Wikibase-defined hook interface, and BooleanRdfMapper
	implements Wikibase's ValueSnakRdfBuilder -- both interfaces live inside
	the Wikibase MediaWiki extension itself (not a standalone Composer
	package), so meaningfully testing them requires running inside an
	actual MediaWiki + Wikibase installation via MediaWiki core's own
	tests/phpunit/phpunit.php entry point, not this file. See HANDOFF.md.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.5/phpunit.xsd"
	backupGlobals="false"
	colors="true"
	convertDeprecationsToExceptions="true">
	<testsuites>
		<testsuite name="WikibaseBoolean">
			<directory>tests/phpunit</directory>
		</testsuite>
	</testsuites>
</phpunit>
